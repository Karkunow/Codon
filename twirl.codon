# Measurement twirling: preprocess/postprocess built as a C shared library.
# Circuits go through the Qiskit C API (libqiskit, built with `make c`).
import heapq
import numpy as np

# Generated by build.sh from the qiskit.h this library is compiled against:
# QK_BUILD_VERSION (QISKIT_VERSION_HEX) and QK_NUM_GATES (number of QkGate values).
from qk_build import QK_BUILD_VERSION, QK_NUM_GATES


@tuple
class Neighbors:  # QkDagNeighbors
    neighbors: Ptr[u32]
    num_neighbors: int


@tuple
class InstView:  # QkCircuitInstructionView
    name: cobj
    qubits: Ptr[u32]
    clbits: Ptr[u32]
    params: cobj
    name_len: int
    num_qubits: u32
    num_clbits: u32
    num_params: int


from C import qk_api_version() -> u32
from C import qk_gate_num_qubits(u8) -> u32
from C import qk_gate_num_params(u8) -> u32
from C import qk_circuit_new(u32, u32) -> cobj
from C import qk_circuit_free(cobj) -> None
from C import qk_circuit_copy(cobj) -> cobj
from C import qk_circuit_num_qubits(cobj) -> u32
from C import qk_circuit_num_instructions(cobj) -> int
from C import qk_circuit_instruction_kind(cobj, int) -> u8
from C import qk_circuit_view_instruction(cobj, int, Ptr[InstView]) -> None
from C import qk_circuit_gate(cobj, u8, Ptr[u32], Ptr[float]) -> u32
from C import qk_circuit_barrier(cobj, Ptr[u32], u32) -> u32
from C import qk_circuit_measure(cobj, u32, u32) -> u32
from C import qk_circuit_reset(cobj, u32) -> u32
from C import qk_circuit_global_phase(cobj) -> cobj
from C import qk_circuit_set_global_phase(cobj, cobj) -> u32
from C import qk_param_free(cobj) -> None
from C import qk_param_kind(cobj) -> u8
from C import qk_param_as_real(cobj) -> float
from C import qk_param_stride() -> int
from C import qk_classical_register_new(u32, cobj) -> cobj
from C import qk_classical_register_free(cobj) -> None
from C import qk_circuit_add_classical_register(cobj, cobj) -> None
from C import qk_circuit_to_dag(cobj) -> cobj
from C import qk_dag_free(cobj) -> None
from C import qk_dag_num_op_nodes(cobj) -> int
from C import qk_dag_topological_op_nodes(cobj, Ptr[u32]) -> None
from C import qk_dag_qubit_out_node(cobj, u32) -> u32
from C import qk_dag_node_type(cobj, u32) -> u8
from C import qk_dag_op_node_kind(cobj, u32) -> u8
from C import qk_dag_op_node_num_qubits(cobj, u32) -> u32
from C import qk_dag_op_node_qubits(cobj, u32) -> Ptr[u32]
from C import qk_dag_op_node_num_params(cobj, u32) -> u32
from C import qk_dag_op_node_gate_op(cobj, u32, Ptr[float]) -> u8
from C import qk_dag_successors(cobj, u32) -> Neighbors
from C import qk_dag_predecessors(cobj, u32) -> Neighbors
from C import qk_dag_neighbors_clear(Ptr[Neighbors]) -> None

# QkDagNodeType_Operation, QkOperationKind_* and QkParamKind_Real in dist/c/include/qiskit/types.h.
QK_NODE_OPERATION = u8(0)
QK_OP_GATE = u8(0)
QK_OP_BARRIER = u8(1)
QK_OP_MEASURE = u8(3)
QK_OP_RESET = u8(4)
QK_PARAM_REAL = u8(1)
U32_MAX = 0xFFFFFFFF

TWIRL_OK = 0
TWIRL_ERR_ARGS = 1              # no tasks, or num_instances < 1
TWIRL_ERR_SHOTS = 2             # shots cannot be split over num_instances
TWIRL_ERR_QUBITS_MISMATCH = 3   # tasks differ in num_qubits
TWIRL_ERR_UNSUPPORTED_OP = 4    # a non-final measure, or an op other than gate/barrier/reset
TWIRL_ERR_TOO_MANY_QUBITS = 5   # bitstrings are packed into int64
TWIRL_ERR_EMPTY_RESULT = 6      # a result has zero shots
TWIRL_ERR_SYMBOLIC_PARAM = 7    # a gate parameter is not a bound real number
TWIRL_ERR_QISKIT_VERSION = 8    # loaded libqiskit is not the one this library was built against

# Fast path for remove_final_measurements (see _remove_final_fast).
FAST_PATH_OFF = 0     # always the DAG port
FAST_PATH_ON = 1      # fast path when the circuit's shape allows it, else the DAG port
FAST_PATH_VERIFY = 2  # run both, compare, use the DAG result on a mismatch and count it
_fast_path_mode = FAST_PATH_ON
_fast_path_hits = 0
_fast_path_mismatches = 0

# Gate name -> QkGate, read from the loaded libqiskit itself on first use (_gate_table).
_gate_by_name: dict[str, int] = {}


@tuple
class Task:
    circuit: cobj  # QkCircuit*
    shots: int


def _view(circuit: cobj, i: int) -> InstView:
    view = InstView(cobj(), Ptr[u32](), Ptr[u32](), cobj(), 0, u32(0), u32(0), 0)
    qk_circuit_view_instruction(circuit, i, __ptr__(view))
    return view


def _param(view: InstView, j: int) -> cobj:
    # QkParam has no compile-time size: step by qk_param_stride() bytes.
    return cobj(Ptr[byte](view.params) + j * qk_param_stride())


def _gate_table() -> dict[str, int]:
    """Gate name -> QkGate, built by appending every QkGate to a scratch circuit and reading back
    its name. The numbering then always matches the loaded libqiskit (version-checked against
    the header, so every value below QK_NUM_GATES is valid)."""
    global _gate_by_name
    if _gate_by_name:
        return _gate_by_name
    for g in range(QK_NUM_GATES):
        gate = u8(g)
        nq = int(qk_gate_num_qubits(gate))
        np_ = int(qk_gate_num_params(gate))
        qubits = Ptr[u32](max(1, nq))
        for q in range(nq):
            qubits[q] = u32(q)
        params = Ptr[float](max(1, np_))
        for p in range(np_):
            params[p] = 0.0
        circuit = qk_circuit_new(u32(nq), u32(0))
        qk_circuit_gate(circuit, gate, qubits, params)
        if qk_circuit_num_instructions(circuit) == 1:
            view = _view(circuit, 0)
            _gate_by_name[str(Ptr[byte](view.name), view.name_len)] = g
        qk_circuit_free(circuit)
    return _gate_by_name


def _params_are_real(circuit: cobj) -> bool:
    # A symbolic parameter would make qk_dag_op_node_gate_op panic and abort the process.
    for i in range(qk_circuit_num_instructions(circuit)):
        view = _view(circuit, i)
        for j in range(view.num_params):
            if qk_param_kind(_param(view, j)) != QK_PARAM_REAL:
                return False
    return True


def _new_bare(circuit: cobj, n: int) -> cobj:
    bare = qk_circuit_new(u32(n), u32(0))
    phase = qk_circuit_global_phase(circuit)
    qk_circuit_set_global_phase(bare, phase)
    qk_param_free(phase)
    return bare


def _neighbors(dag: cobj, node: int, successors: bool) -> list[int]:
    nb = qk_dag_successors(dag, u32(node)) if successors else qk_dag_predecessors(dag, u32(node))
    out = [int(nb.neighbors[i]) for i in range(nb.num_neighbors)]
    qk_dag_neighbors_clear(__ptr__(nb))
    return out


def _shares_qubit(dag: cobj, a: int, b: int) -> bool:
    qa = qk_dag_op_node_qubits(dag, u32(a))
    qb = qk_dag_op_node_qubits(dag, u32(b))
    for i in range(int(qk_dag_op_node_num_qubits(dag, u32(a)))):
        for j in range(int(qk_dag_op_node_num_qubits(dag, u32(b)))):
            if qa[i] == qb[j]:
                return True
    return False


def _final_ops(dag: cobj, n: int) -> set[int]:
    # Port of calc_final_ops in qiskit/transpiler/passes/utils/remove_final_measurements.py.
    final: set[int] = set()
    barrier_encounters_remaining: dict[int, int] = {}
    to_visit = [_neighbors(dag, int(qk_dag_qubit_out_node(dag, u32(q))), False)[0] for q in range(n)]
    while to_visit:
        node = to_visit.pop()
        if qk_dag_node_type(dag, u32(node)) != QK_NODE_OPERATION:
            continue
        kind = qk_dag_op_node_kind(dag, u32(node))
        if kind == QK_OP_BARRIER:
            # A barrier is final once it has been reached from every one of its successors.
            if node not in barrier_encounters_remaining:
                barrier_encounters_remaining[node] = len(_neighbors(dag, node, True))
            if barrier_encounters_remaining[node] - 1 > 0:
                barrier_encounters_remaining[node] -= 1
                continue
        if kind == QK_OP_MEASURE or kind == QK_OP_BARRIER:
            final.add(node)
            # Quantum predecessors only: a predecessor reached over a clbit wire does not count.
            for p in _neighbors(dag, node, False):
                if qk_dag_node_type(dag, u32(p)) == QK_NODE_OPERATION and _shares_qubit(dag, node, p):
                    to_visit.append(p)
    return final


def _remove_final_dag(circuit: cobj, n: int) -> cobj:
    """remove_final_measurements(inplace=False) for circuits whose clbits all become idle.

    Rebuilds the circuit without clbits in the DAG's topological order, as dag_to_circuit does.
    Returns a null cobj if the circuit has a non-final measure or an op other than
    gate/barrier/reset.
    """
    dag = qk_circuit_to_dag(circuit)
    final = _final_ops(dag, n)
    bare = _new_bare(circuit, n)
    num_ops = qk_dag_num_op_nodes(dag)
    order = Ptr[u32](num_ops)
    qk_dag_topological_op_nodes(dag, order)
    supported = True
    for i in range(num_ops):
        node = order[i]
        if int(node) in final:
            continue
        kind = qk_dag_op_node_kind(dag, node)
        qubits = qk_dag_op_node_qubits(dag, node)
        if kind == QK_OP_GATE:
            params = Ptr[float](max(1, int(qk_dag_op_node_num_params(dag, node))))
            gate = qk_dag_op_node_gate_op(dag, node, params)
            qk_circuit_gate(bare, gate, qubits, params)
        elif kind == QK_OP_BARRIER:
            qk_circuit_barrier(bare, qubits, qk_dag_op_node_num_qubits(dag, node))
        elif kind == QK_OP_RESET:
            qk_circuit_reset(bare, qubits[0])
        else:
            supported = False
            break
    qk_dag_free(dag)
    if not supported:
        qk_circuit_free(bare)
        return cobj()
    return bare


def _remove_final_fast(circuit: cobj, n: int) -> cobj:
    """remove_final_measurements without building a DAG, for one common shape.

    Applies when the circuit is gates/resets followed by a tail of measures/barriers: every tail
    op is then final in calc_final_ops' sense and nothing before the tail is. The kept ops are
    emitted in the order dag_to_circuit would use: rustworkx's lexicographical topological sort
    keyed by DAGCircuit::sort_key, (qubits, clbits), over the qubit in-nodes and the ops.
    Returns a null cobj for any other shape; the caller then takes the DAG path.
    """
    gates_by_name = _gate_table()
    num = qk_circuit_num_instructions(circuit)
    cut = num
    while cut > 0:
        kind = qk_circuit_instruction_kind(circuit, cut - 1)
        if kind != QK_OP_MEASURE and kind != QK_OP_BARRIER:
            break
        cut -= 1
    for i in range(cut, num):
        if _view(circuit, i).num_qubits == u32(0):
            return cobj()

    gates = [0] * cut  # QkGate, or -1 for a reset
    qubits_of: list[list[int]] = []
    for i in range(cut):
        kind = qk_circuit_instruction_kind(circuit, i)
        view = _view(circuit, i)
        if view.num_qubits == u32(0):
            return cobj()  # e.g. global_phase: no wire places it in the order, the DAG does
        if kind == QK_OP_GATE:
            name = str(Ptr[byte](view.name), view.name_len)
            if name not in gates_by_name:
                return cobj()
            gates[i] = gates_by_name[name]
        elif kind == QK_OP_RESET:
            gates[i] = -1
        else:
            return cobj()
        qubits_of.append([int(view.qubits[j]) for j in range(int(view.num_qubits))])

    # Graph: in-node q (index q, key ([q], [U32_MAX])) and op i (index n + i, key (qubits, [])).
    # An op has one incoming edge per qubit; succ[i][j] is the next op on op i's j-th qubit.
    last_op = [-1] * n
    last_slot = [0] * n
    in_succ = [-1] * n
    indeg = [0] * cut
    succ: list[list[int]] = [[-1] * len(qubits_of[i]) for i in range(cut)]
    for i in range(cut):
        qs = qubits_of[i]
        for j in range(len(qs)):
            q = qs[j]
            if last_op[q] < 0:
                in_succ[q] = i
            else:
                succ[last_op[q]][last_slot[q]] = i
            indeg[i] += 1
            last_op[q] = i
            last_slot[q] = j

    in_clbits = [U32_MAX]
    no_clbits: list[int] = []
    ready: list[tuple[list[int], list[int], int]] = [([q], in_clbits, q) for q in range(n)]
    heapq.heapify(ready)
    order: list[int] = []
    while ready:
        node = heapq.heappop(ready)[2]
        nexts = [in_succ[node]] if node < n else succ[node - n]
        if node >= n:
            order.append(node - n)
        for s in nexts:
            if s >= 0:
                indeg[s] -= 1
                if indeg[s] == 0:
                    heapq.heappush(ready, (qubits_of[s], no_clbits, n + s))

    bare = _new_bare(circuit, n)
    params = Ptr[float](8)
    for i in order:
        view = _view(circuit, i)
        if gates[i] < 0:
            qk_circuit_reset(bare, view.qubits[0])
        else:
            for j in range(view.num_params):
                params[j] = qk_param_as_real(_param(view, j))
            qk_circuit_gate(bare, u8(gates[i]), view.qubits, params)
    return bare


def _same_circuit(a: cobj, b: cobj) -> bool:
    num = qk_circuit_num_instructions(a)
    if num != qk_circuit_num_instructions(b):
        return False
    pa = qk_circuit_global_phase(a)
    pb = qk_circuit_global_phase(b)
    same = qk_param_as_real(pa) == qk_param_as_real(pb)
    qk_param_free(pa)
    qk_param_free(pb)
    for i in range(num):
        if not same:
            break
        va = _view(a, i)
        vb = _view(b, i)
        same = (str(Ptr[byte](va.name), va.name_len) == str(Ptr[byte](vb.name), vb.name_len)
                and va.num_qubits == vb.num_qubits and va.num_clbits == vb.num_clbits
                and va.num_params == vb.num_params)
        for j in range(int(va.num_qubits) if same else 0):
            same = same and va.qubits[j] == vb.qubits[j]
        for j in range(int(va.num_clbits) if same else 0):
            same = same and va.clbits[j] == vb.clbits[j]
        for j in range(va.num_params if same else 0):
            same = same and qk_param_as_real(_param(va, j)) == qk_param_as_real(_param(vb, j))
    return same


def _remove_final_measurements(circuit: cobj, n: int) -> cobj:
    global _fast_path_hits, _fast_path_mismatches
    if _fast_path_mode == FAST_PATH_OFF:
        return _remove_final_dag(circuit, n)
    fast = _remove_final_fast(circuit, n)
    if fast == cobj():
        return _remove_final_dag(circuit, n)
    if _fast_path_mode == FAST_PATH_VERIFY:
        slow = _remove_final_dag(circuit, n)
        if slow == cobj() or not _same_circuit(fast, slow):
            _fast_path_mismatches += 1
            qk_circuit_free(fast)
            return slow
        qk_circuit_free(slow)
    _fast_path_hits += 1
    return fast


def _add_meas_register(circuit: cobj, n: int):
    # The "meas" register of QuantumCircuit.measure_all(), added to the bare circuit once per task:
    # every copy inherits it, so the per-copy tail is only the barrier and the measures.
    reg = qk_classical_register_new(u32(n), "meas".c_str())
    qk_circuit_add_classical_register(circuit, reg)
    qk_classical_register_free(reg)


def _measure_tail(circuit: cobj, n: int):
    # The rest of measure_all(): barrier, qubit q -> clbit q.
    qk_circuit_barrier(circuit, Ptr[u32](), u32(0))
    for q in range(n):
        qk_circuit_measure(circuit, u32(q), u32(q))


def _free_all(circuits: list[cobj]):
    for c in circuits:
        qk_circuit_free(c)


@export
def twirl_set_fast_path(mode: int) -> int:
    """FAST_PATH_OFF / _ON (default) / _VERIFY. Returns the previous mode, or -1 for a bad mode."""
    global _fast_path_mode
    if mode < FAST_PATH_OFF or mode > FAST_PATH_VERIFY:
        return -1
    previous = _fast_path_mode
    _fast_path_mode = mode
    return previous


@export
def twirl_fast_path_hits() -> int:
    """Circuits whose bare copy came from the fast path, since the library was loaded."""
    return _fast_path_hits


@export
def twirl_fast_path_mismatches() -> int:
    """In FAST_PATH_VERIFY mode: circuits where the fast path disagreed with the DAG port."""
    return _fast_path_mismatches


@export
def twirl_preprocess(tasks: Ptr[Task], num_tasks: int, num_instances: int, seed: int,
                     out_tasks: Ptr[Task], out_flips: Ptr[u8]) -> int:
    """out_tasks: num_tasks * num_instances; out_flips: num_instances * num_qubits.

    Final measurements and barriers are removed as remove_final_measurements does.
    The caller frees every out_tasks[i].circuit with qk_circuit_free.
    """
    if int(qk_api_version()) != QK_BUILD_VERSION:
        return TWIRL_ERR_QISKIT_VERSION
    if num_tasks < 1 or num_instances < 1:
        return TWIRL_ERR_ARGS
    n = int(qk_circuit_num_qubits(tasks[0].circuit))
    if n > 63:
        return TWIRL_ERR_TOO_MANY_QUBITS
    gate_x = u8(_gate_table()["x"])
    bares: list[cobj] = []
    for t in range(num_tasks):
        if tasks[t].shots < num_instances:
            _free_all(bares)
            return TWIRL_ERR_SHOTS
        if int(qk_circuit_num_qubits(tasks[t].circuit)) != n:
            _free_all(bares)
            return TWIRL_ERR_QUBITS_MISMATCH
        if not _params_are_real(tasks[t].circuit):
            _free_all(bares)
            return TWIRL_ERR_SYMBOLIC_PARAM
        bare = _remove_final_measurements(tasks[t].circuit, n)
        if bare == cobj():
            _free_all(bares)
            return TWIRL_ERR_UNSUPPORTED_OP
        _add_meas_register(bare, n)
        bares.append(bare)

    # flips[j, q] == 1 puts an X on qubit q right before measurement in copy j.
    flips = np.random.default_rng(seed).integers(0, 2, size=(num_instances, n))
    for j in range(num_instances):
        for q in range(n):
            out_flips[j * n + q] = u8(int(flips[j, q]))

    qubit = Ptr[u32](1)
    for t in range(num_tasks):
        for j in range(num_instances):
            circuit = qk_circuit_copy(bares[t])
            for q in range(n):
                if out_flips[j * n + q]:
                    qubit[0] = u32(q)
                    qk_circuit_gate(circuit, gate_x, qubit, Ptr[float]())
            _measure_tail(circuit, n)
            out_tasks[t * num_instances + j] = Task(circuit, tasks[t].shots // num_instances)
    _free_all(bares)
    return TWIRL_OK


@export
def twirl_postprocess(bits: Ptr[int], counts: Ptr[int], offsets: Ptr[int], num_tasks: int,
                      flips: Ptr[u8], num_instances: int, num_qubits: int,
                      out_bits: Ptr[int], out_probs: Ptr[float], out_offsets: Ptr[int]) -> int:
    """Result r = t * num_instances + j holds entries [offsets[r], offsets[r + 1]).

    out_bits/out_probs need offsets[num_tasks * num_instances] slots; out_offsets num_tasks + 1.
    Task t's merged distribution is written to [out_offsets[t], out_offsets[t + 1]).
    """
    k = num_instances
    n = num_qubits
    # Qiskit bitstrings are little-endian: qubit q is bit q of int(bits, 2).
    masks = [0] * k
    for j in range(k):
        for q in range(n):
            if int(flips[j * n + q]):
                masks[j] |= 1 << q

    w = 0
    out_offsets[0] = 0
    for t in range(num_tasks):
        probs: dict[int, float] = {}
        for j in range(k):
            r = t * k + j
            shots = 0
            for e in range(offsets[r], offsets[r + 1]):
                shots += counts[e]
            if shots == 0:
                return TWIRL_ERR_EMPTY_RESULT
            for e in range(offsets[r], offsets[r + 1]):
                unflipped = bits[e] ^ masks[j]
                probs[unflipped] = probs.get(unflipped, 0.0) + counts[e] / shots / k
        for unflipped, p in probs.items():
            out_bits[w] = unflipped
            out_probs[w] = p
            w += 1
        out_offsets[t + 1] = w
    return TWIRL_OK
